# ---- Required ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solarflow
JWT_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# ---- Optional (defaults shown) ----
SESSION_HOURS=8
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads

# Used only by `npm run seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
